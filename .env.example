# web
AUTH_SECRET=...                    # shared with backend — signs/verifies the session JWT
AUTH_GITHUB_ID=...                 # GitHub OAuth app id
AUTH_GITHUB_SECRET=...             # GitHub OAuth app secret
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_HOCUSPUS_URL=ws://localhost:1234

# backend
AUTH_SECRET=...                    # same value
DATABASE_URL=postgres://cloro:cloro@localhost:5432/cloro
OPENAI_API_KEY=...                 # backend only
WEB_ORIGIN=http://localhost:3000   # CORS allowlist
PORT=4000
HOCUSPUS_PORT=1234
